# Maintainer: savruun <https://github.com/savruun>
#
# The template for the AUR package. .github/workflows/aur.yml sets pkgver and
# the checksums for each release and pushes the result to the AUR.

pkgname=embr-bin
pkgver=0.6.0
pkgrel=1
pkgdesc="A package manager built for Luau: publish, discover, and install packages for Luau and everything built on it"
arch=('x86_64')
url="https://github.com/ember-luau/ember"
license=('MIT')
# embr clones package indices with git
depends=('gcc-libs' 'glibc' 'git')
provides=('embr')
conflicts=('embr')
# the release binary ships without debug info, so a -debug package would be empty
options=('!debug')
source=("embr-linux-x86_64-$pkgver.zip::$url/releases/download/v$pkgver/embr-linux-x86_64.zip"
        "LICENSE-$pkgver::https://raw.githubusercontent.com/ember-luau/ember/v$pkgver/LICENSE")
sha256sums=('76ae0157656a842ce6bcffc58e9b355a0a082aa7df978610f4c9c2f33c844af9'
            '8036b3444921bc02dd288bb0c87511ea0436621722735e00a258c16363e865ab')

package() {
  install -Dm755 embr "$pkgdir/usr/bin/embr"
  install -Dm644 "LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
