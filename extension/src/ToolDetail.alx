--[[
  One tool: how to get it, its tags and facts, its versions with their
  files, and the notes of the newest one. A tool without the `cli` tag
  is no embr install, so the view gives its page on the site instead.
]]

import { create } from '@packages/svelte-aly'
import { tool_detail, type Tool, type ToolVersion } from './api'
import { CopyField } from './CopyField'
import { count } from './format'
import { Icon } from './Icon'
import { org_name } from './PackageCard'
import { Spinner } from './Spinner'
import { ToolVersions } from './ToolVersions'
import { BRAND } from './theme'

--- The props of [ToolDetail].
export type ToolDetailProps = { tool: Tool, on_back: () -> () }

--- The page of one tool.
export function ToolDetail(props: ToolDetailProps) -> Instance
  const tool = props.tool
  local versions: { ToolVersion } = $state([])
  local loaded = $state(false)
  local failed = $state(false)

  $effect(function()
    const job = task.spawn(function()
      match Result.pcall(tool_detail, tool.scope, tool.name) with
        case Ok(found) then
          versions = found.versions
          loaded = true
        case Err(_) then failed = true
      end
    end)

    return function() task.cancel(job) end
  end)

  -- The versions are in once `loaded` is, and stay; the call reads them
  -- as a plain list.
  local function versions_view() -> Instance
    return ToolVersions({ list = versions })
  end

  const full = `{tool.scope}/{tool.name}`
  const cli = table.find(tool.tags, 'cli') ~= nil
  const command = if cli then `embr tool add ember:{full}` else `https://emberpm.dev/tool/{full}`

  return <ScrollingFrame
    ClassName="ghost w-full fill scroll-y canvas-auto scrollbar-4 flex-col gap-4 p-4"
    ScrollBarImageColor3={Color3.fromRGB(63, 63, 70)}
    BorderSizePixel={0}
  >
    <TextButton ClassName="ghost w-auto h-6 flex items-center gap-1.5 no-auto-color" Text="" Activated={function() props.on_back() end}>
      <Icon name="arrow-left" weight="bold" size={14} />
      <TextLabel ClassName="ghost w-auto h-6 text-xs text-zinc-400 hover:text-zinc-100">Back</TextLabel>
    </TextButton>

    <Frame ClassName="ghost w-full h-auto flex-col gap-1.5">
      <Frame ClassName="ghost w-full h-7 flex items-center gap-2">
        <Icon name="wrench" weight="duotone" size={22} color={BRAND} />
        <TextLabel ClassName="ghost w-auto h-7 text-lg font-bold text-zinc-100 truncate">{full}</TextLabel>
        {#if tool.latest}
          <TextLabel ClassName="w-auto h-5 px-2 rounded bg-zinc-800 text-xs font-mono text-zinc-300">v{tool.latest}</TextLabel>
        {/if}
      </Frame>
      <TextLabel ClassName="ghost w-full h-auto text-sm text-zinc-400 text-left text-wrap leading-[1.2]">
        {tool.description}
      </TextLabel>
    </Frame>

    <CopyField text={command} icon={if cli then 'terminal' else 'arrow-square-out'} />

    <Frame ClassName="ghost w-full h-auto flex flex-wrap gap-1.5">
      {#each tool.tags as tag (tag)}
        <TextLabel ClassName="w-auto h-6 px-2.5 rounded-full bg-zinc-900 stroke stroke-zinc-800 text-xs text-zinc-300">{tag}</TextLabel>
      {/each}
    </Frame>

    <Frame ClassName="ghost w-full h-auto flex flex-wrap gap-x-4 gap-y-1.5">
      <Frame ClassName="ghost w-auto h-4 flex items-center gap-1">
        <Icon name="download-simple" size={12} />
        <TextLabel ClassName="ghost w-auto h-4 text-xs text-zinc-400">{count(tool.downloads)} downloads</TextLabel>
      </Frame>
      {#if tool.source == 'github'}
        <Frame ClassName="ghost w-auto h-4 flex items-center gap-1">
          <Icon name="github-logo" size={12} />
          <TextLabel ClassName="ghost w-auto h-4 text-xs text-zinc-400">Pinned from {tool.repository or 'GitHub'}</TextLabel>
        </Frame>
      {/if}
      {#if tool.org}
        <Frame ClassName="ghost w-auto h-4 flex items-center gap-1">
          <Icon name="buildings" size={12} />
          <TextLabel ClassName="ghost w-auto h-4 text-xs text-zinc-400">{org_name(tool)}</TextLabel>
        </Frame>
      {/if}
    </Frame>

    {#if failed}
      <TextLabel ClassName="ghost w-full h-auto text-xs text-zinc-500 text-wrap">Ember did not send the versions. Try again soon.</TextLabel>
    {:else if not loaded}
      <Spinner label="Loading the versions" />
    {:else}
      {versions_view()}
    {/if}
  </ScrollingFrame>
end

